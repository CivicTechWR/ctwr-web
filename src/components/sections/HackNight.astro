---
import Section from '../Section.astro'; import SectionTitle from '../SectionTitle.astro'; import Shape from '../Shape.astro'; import Photo from '../Photo.astro';
import Agenda from '../Agenda.astro'; import EventCard from '../EventCard.astro'; import InfoCard from '../InfoCard.astro'; import Button from '../Button.astro';
import { rich } from '../../lib/rich';
import { season as loadSeason, PHASES } from '../../lib/data';
import { upcomingHackNights } from '../../lib/luma';
import type { Section as S } from '../../content.config';
interface Props { s: Extract<S, { type: 'hack_night' }>; bg: string; rule: boolean; kickerColor: string }
const { s, bg, rule, kickerColor } = Astro.props;
const [next] = await upcomingHackNights(1);
const season = loadSeason();
const phase = season.weeks[season.current_week - 1];
---
<Section bg={bg} border={rule} id="next-hacknight">
  <div class="split split--top">
    <div class="col" style="flex: 1 1 520px; gap: 20px;">
      <SectionTitle kicker={s.kicker} kickerColor={kickerColor}>{s.heading}</SectionTitle>
      {s.intro && <p class="lead" style="margin-bottom: 16px; max-width: 560px;">{s.intro}</p>}
      {s.agenda.length > 0 && <Agenda stops={s.agenda} />}
    </div>
    <div style="flex: 1 1 440px; display: flex; flex-direction: column; gap: 32px; padding-top: 8px;">
      {s.card ? <InfoCard card={s.card} />
        : next && <EventCard event={next} focus={phase && `${PHASES[phase]} week`} />}
      {(s.details || s.button) && <div class="col" style="gap: 16px;">
        {s.details && <div class="rt" set:html={rich(s.details)} />}
        {s.button && <Button href={s.button.url} variant={s.button.style} arrow>{s.button.label}</Button>}
      </div>}
      {s.image && <Photo src={s.image.src || undefined} alt={s.image.alt} placeholder={s.image.alt} tilt="left" />}
    </div>
  </div>
  <Shape slot="deco" type="zigzag" size={0.7} at="bottom: 40px; right: 3%;" />
</Section>
