---
import Button from './Button.astro';
import { summaryOf, formatDate, slugify, type Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const href = `/blog/${post.id}/`;
---
<li>
  <div class="ct-postlist-main">
    <h3 class="ct-post-title"><a href={href}>{post.data.title}</a></h3>
    <div class="ct-post-meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      {post.data.tags.length > 0 && <>
        <span aria-hidden="true">·</span>
        <ul class="ct-tags" aria-label="Tags">
          {post.data.tags.map((t) => <li><a class="ct-tag-sm" href={`/blog/tag/${slugify(t)}/`}>{t}</a></li>)}
        </ul>
      </>}
    </div>
    <p class="ct-post-sum">{summaryOf(post)}</p>
    <div class="ct-postlist-more"><Button href={href} size="sm" arrow>Read post<span class="ct-sr">: {post.data.title}</span></Button></div>
  </div>
</li>
