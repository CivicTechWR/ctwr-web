---
// Pixel-art Memphis decorations, drawn on a grid of square cells. `at` positions it absolutely inside the nearest Section.
interface Props {
  type: 'squiggle' | 'zigzag' | 'dots' | 'plus' | 'equals' | 'ring' | 'half' | 'capsule';
  color?: string;
  size?: number;
  at?: string;
}
const { type, color = 'meadow-6', size = 1, at } = Astro.props;

type Cells = [number, number][];
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const fromRows = (rows: string[]): Cells => rows.flatMap((r, y) => [...r].flatMap((c, x) => (c === '#' ? [[x, y] as [number, number]] : [])));

// A thick line through one y value per column, with no gaps between columns.
const line = (ys: number[], thick = 2): Cells => ys.flatMap((y, x) => {
  const prev = ys[x - 1] ?? y;
  return range(Math.abs(y - prev) + thick).map((i) => [x, Math.min(y, prev) + i] as [number, number]);
});

// cell: pixel size of one cell. outline: add a 1-cell ink border around the colour fill.
const SHAPES: Record<Props['type'], { cell: number; fill: Cells; outline?: boolean; ink?: boolean }> = {
  squiggle: { cell: 6, fill: line(range(28).map((x) => Math.round(2.5 - 2.5 * Math.sin((2 * Math.PI * x) / 14)))) },
  zigzag: { cell: 6, fill: line(range(29).map((x) => Math.abs((x % 8) - 4))) },
  dots: { cell: 4, ink: true, fill: range(40).flatMap((i) => {
    const x = (i % 8) * 6, y = Math.floor(i / 8) * 6;
    return [[x, y], [x + 1, y], [x, y + 1], [x + 1, y + 1]] as Cells;
  }) },
  plus: { cell: 6, outline: true, fill: fromRows(['...##...', '...##...', '...##...', '########', '########', '...##...', '...##...', '...##...']) },
  equals: { cell: 6, outline: true, fill: fromRows(['########', '########', '........', '........', '########', '########']) },
  ring: { cell: 6, outline: true, fill: fromRows(['.####.', '######', '######', '######', '######', '.####.']) },
  half: { cell: 6, outline: true, fill: fromRows(['....####....', '..########..', '.##########.', '############', '############']) },
  capsule: { cell: 6, outline: true, fill: fromRows(['......##', '.....###', '....###.', '...###..', '..###...', '.###....', '###.....', '##......']) },
};

const { cell, fill, outline, ink } = SHAPES[type];
const pad = outline ? 1 : 0;
const key = (x: number, y: number) => `${x},${y}`;
const filled = new Set(fill.map(([x, y]) => key(x, y)));
const border: Cells = outline
  ? [...new Set(fill.flatMap(([x, y]) => [[x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]].map(([a, b]) => key(a, b))))]
      .filter((k) => !filled.has(k)).map((k) => k.split(',').map(Number) as [number, number])
  : [];
const w = Math.max(...fill.map(([x]) => x)) + 1 + pad * 2;
const h = Math.max(...fill.map(([, y]) => y)) + 1 + pad * 2;

// Merge horizontal runs of cells into single rects.
const runs = (cells: Cells) => {
  const rows = new Map<number, number[]>();
  for (const [x, y] of cells) rows.set(y, [...(rows.get(y) ?? []), x]);
  return [...rows].flatMap(([y, xs]) => {
    xs.sort((a, b) => a - b);
    const out: { x: number; y: number; w: number }[] = [];
    for (const x of xs) {
      const last = out.at(-1);
      if (last && last.x + last.w === x + pad) last.w++;
      else out.push({ x: x + pad, y: y + pad, w: 1 });
    }
    return out;
  });
};
const col = ink ? 'var(--ink)' : `var(--${color})`;
---
<span class:list={[at && 'ct-deco']} style={at} aria-hidden="true">
  <svg class="ct-shape" width={w * cell * size} height={h * cell * size} viewBox={`0 0 ${w} ${h}`} shape-rendering="crispEdges" focusable="false">
    {runs(border).map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill="var(--ink)" />)}
    {runs(fill).map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={col} />)}
  </svg>
</span>
