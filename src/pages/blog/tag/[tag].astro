---
import Base from '../../../layouts/Base.astro';
import Sections from '../../../components/Sections.astro';
import { blogListing } from '../../../lib/pages';
import { slugify } from '../../../lib/posts';
export async function getStaticPaths() {
  const { posts } = await blogListing();
  return [...new Set(posts.flatMap((p) => p.data.tags))].map((tag) => ({ params: { tag: slugify(tag) }, props: { tag } }));
}
const { tag } = Astro.props;
const { blog, posts: all } = await blogListing();
const posts = all.filter((p) => p.data.tags.includes(tag));
---
<Base title={`${tag} · ${blog.title}`} description={blog.description}>
  <Sections sections={blog.sections} titleOverride={tag} posts={{ posts, total: posts.length, page: 1, pages: 1, activeTag: tag }} />
</Base>
